{
  "functions": {
    "api/proxy.php": { "runtime": "vercel-php@0.7.1" },
    "index.php": { "runtime": "vercel-php@0.7.1" },
    "dashboard.php": { "runtime": "vercel-php@0.7.1" },
    "fan-zone.php": { "runtime": "vercel-php@0.7.1" }
  },
  "routes": [
    { "src": "/assets/(.+)", "dest": "/assets/$1" },
    { "src": "/api/(.*)", "dest": "/api/$1" },
